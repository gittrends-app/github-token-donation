# Public URL of the app (used for redirects) and the next-auth secret (`openssl rand -base64 32`)
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# GitHub OAuth App (Authorization callback URL: <NEXTAUTH_URL>/api/github)
GH_CLIENT_ID=
GH_CLIENT_SECRET=
NEXT_PUBLIC_GH_CLIENT_ID=$GH_CLIENT_ID
NEXT_PUBLIC_GH_SCOPES=public_repo,read:org,read:user


#Admin login info
ADMIN_LOGIN_SECRET=
ADMIN_EMAIL_SECRET=
ADMIN_PASSWORD_SECRET=

# Email notifications on every donation (set SMTP=true to enable)
SMTP=false
SMTP_HOST=
SMTP_PORT=
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=

# SQLite database file (created on first use; keep it out of public/ and back it up)
DB_PATH=data/tokens.db


# Messages (all optional, defaults live in lib/messages.ts)
NEXT_PUBLIC_NAME=Git Token Donation
NEXT_PUBLIC_TITLE=Donate a GitHub access token
NEXT_PUBLIC_MESSAGE=We make thousands of GitHub API requests to keep our database updated. With more tokens we can expand our dataset and speed up the data processing.
NEXT_PUBLIC_DONATE_BUTTON=Donate
NEXT_PUBLIC_HOME_BUTTON=Home
NEXT_PUBLIC_ADMIN_BUTTON=Admin
NEXT_PUBLIC_ADMIN_LOGOUT_BUTTON=Logout
NEXT_PUBLIC_THANKS_TITLE=Thank you
NEXT_PUBLIC_THANKS_MESSAGE=You have successfully donated a token.
NEXT_PUBLIC_ERROR_TITLE=Error
NEXT_PUBLIC_DB_ERROR_MESSAGE=Error trying to reach Database
NEXT_PUBLIC_GH_ERROR_MESSAGE=Error trying to reach GitHub
NEXT_PUBLIC_UNEXPECTED_ERROR_MESSAGE=Something unexpected happened, try again later
