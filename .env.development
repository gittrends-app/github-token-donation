# Development defaults, loaded automatically by `next dev` (ignored by `next build` / `next start`).
# Committed on purpose: these values are for local development only.
# Personal values (e.g. GitHub OAuth credentials) go in .env.local, which overrides this file and is gitignored.
# Production: define the same variables in the host environment (or .env.production.local) with real values.

# Public URL of the app, used for redirects (must not be empty; set your real domain in production)
NEXTAUTH_URL=http://localhost:3000
# next-auth secret; in production generate one with `openssl rand -base64 32`
NEXTAUTH_SECRET=dev-only-secret-do-not-use-in-production

# GitHub OAuth App (Authorization callback URL: <NEXTAUTH_URL>/api/github)
# Create your own app and set these two in .env.local (left undefined here so they aren't shadowed):
# GH_CLIENT_ID=
# GH_CLIENT_SECRET=
GH_SCOPES=public_repo,read:org,read:user

# Admin login (dev only: admin / admin)
ADMIN_LOGIN_SECRET=admin
ADMIN_PASSWORD_SECRET=admin
ADMIN_EMAIL_SECRET=admin@localhost
# Language of the notification emails sent to admins (en or pt-BR)
ADMIN_LOCALE=pt-BR

# Email notifications on every donation (SMTP=false disables them)
# Defaults point to the local Mailpit from docker-compose (inbox at http://localhost:8025).
# Customize for production: set your SMTP host/port and credentials, and SMTP_AUTH=true to use SSL.
SMTP=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=

# SQLite database file (created on first use; keep it out of public/ and back it up)
DB_PATH=data/tokens.db
